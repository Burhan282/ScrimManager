@page
@model ScrimManagerPresentation.Pages.Presentation.Account.LoginModel

<div class="auth-container">

    <div class="auth-card">

        <h1>Login</h1>

        <p class="auth-subtitle">
            Login to your ScrimManager account
        </p>

        <form method="post">

            <div class="mb-3">

                <label>Email</label>

                <input asp-for="Email"
                       type="email"
                       class="form-control auth-input" />

            </div>

            <div class="mb-4">

                <label>Password</label>

                <input asp-for="Password"
                       type="password"
                       class="form-control auth-input" />

            </div>

            <button type="submit"
                    class="btn auth-button w-100">

                Login

            </button>

        </form>

    </div>

</div>