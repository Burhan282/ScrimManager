@page
@model ScrimManagerPresentation.Pages.Presentation.Team.TeamIndexModel

<div class="teams-page">
    <div class="teams-header">
        <div class="teams-title">
            <h1>🏆 Teams</h1>
            <p>Bekijk alle teams en open hun profiel.</p>
        </div>

        <a asp-page="./CreateTeam" class="btn-create">
            + Create Team
        </a>
    </div>

    <div class="teams-grid">
        @foreach (var team in Model.Teams)
        {
            <div class="team-card">
                <div class="team-banner"></div>

                <div class="team-content">
                    <div class="team-logo">
                        @if (team.LogoData != null && team.LogoData.Length > 0)
                        {
                            var base64 = Convert.ToBase64String(team.LogoData);
                            var imgSrc = $"data:image/png;base64,{base64}";

                            <img src="@imgSrc" alt="Team logo" />
                        }
                        else
                        {
                            @team.Name.Substring(0, 1).ToUpper()
                        }
                    </div>

                    <h3>@team.Name</h3>

                    <div class="team-info">
                        <span>🌍 @team.Teamregion</span>
                        <span>⭐ @team.Teamrank</span>
                    </div>

                    <form method="post" asp-page-handler="Join" asp-route-id="@team.Id">
                        <button type="submit" class="join-btn">
                            Apply Team
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>