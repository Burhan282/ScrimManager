@page "/tournaments/Create"
@model ScrimManagerPresentation.Pages.Presentation.Tournament.CreateModel

@{
    ViewData["Title"] = "Create Tournament";
}

<div class="create-page">
    <div class="create-card">

        <div class="create-header">
            <h1>Create Tournament</h1>
            <p>Quickly create a new Rocket League tournament.</p>
        </div>

        <div class="create-body">

            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <form method="post">

                <div class="form-grid">

                    <div class="form-group form-group-full">
                        <label asp-for="CreateTournamentDTO.Naam"></label>
                        <input asp-for="CreateTournamentDTO.Naam" class="form-control" />
                        <span asp-validation-for="CreateTournamentDTO.Naam" class="field-validation-error"></span>
                    </div>

                    <div class="form-group form-group-full">
                        <label asp-for="CreateTournamentDTO.Organisator"></label>
                        <input asp-for="CreateTournamentDTO.Organisator" class="form-control" />
                        <span asp-validation-for="CreateTournamentDTO.Organisator" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CreateTournamentDTO.SelectedDate"></label>
                        <input asp-for="CreateTournamentDTO.SelectedDate" type="date" class="form-control" />
                        <span asp-validation-for="CreateTournamentDTO.SelectedDate"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CreateTournamentDTO.SelectedTime"></label>
                        <input asp-for="CreateTournamentDTO.SelectedTime" type="time" class="form-control" />
                        <span asp-validation-for="CreateTournamentDTO.SelectedTime"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CreateTournamentDTO.Format"></label>
                        <select asp-for="CreateTournamentDTO.Format" class="form-control">
                            <option value="">Select format</option>
                            <option>1v1</option>
                            <option>2v2</option>
                            <option>3v3</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="CreateTournamentDTO.MaxTeams"></label>
                        <select asp-for="CreateTournamentDTO.MaxTeams" class="form-control">
                            <option value="">Select max teams</option>
                            <option>8</option>
                            <option>16</option>
                            <option>32</option>
                            <option>64</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="CreateTournamentDTO.PrizeMoney"></label>
                        <input asp-for="CreateTournamentDTO.PrizeMoney" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="CreateTournamentDTO.PrizeMoney"></span>
                    </div>

                    <div class="form-group form-group-full">
                        <label asp-for="CreateTournamentDTO.Description"></label>
                        <textarea asp-for="CreateTournamentDTO.Description" class="form-control"></textarea>
                        <span asp-validation-for="CreateTournamentDTO.Description"></span>
                    </div>

                </div>

                <div class="helper-text">
                    Status will automatically be set to <strong>Open</strong>
                </div>

                <div class="actions">
                    <button type="submit" class="btn-save">Save Tournament</button>
                    <a asp-page="/Presentation/Tournament/TournamentIndex" class="btn-cancel">Cancel</a>
                </div>

            </form>

        </div>
    </div>
</div>
