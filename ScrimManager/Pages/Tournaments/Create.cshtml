@page
@model ScrimManager.Pages.Tournaments.CreateModel

<style>
    body {
        background: #f3f4f6;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .create-page {
        max-width: 760px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .create-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(0,0,0,0.12);
    }

    .create-header {
        background: #0d3b5f;
        color: white;
        padding: 24px 28px;
    }

        .create-header h1 {
            margin: 0 0 6px 0;
            font-size: 30px;
        }

        .create-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 14px;
        }

    .create-body {
        padding: 24px 28px 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group-full {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #1f2937;
        font-size: 14px;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 12px 13px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        font-size: 14px;
        background: white;
        color: #111827;
    }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #1da1f2;
            box-shadow: 0 0 0 3px rgba(29, 161, 242, 0.12);
        }

    .helper-text {
        margin-top: 12px;
        color: #6b7280;
        font-size: 13px;
    }

    .validation-summary-errors {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 8px;
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 13px;
    }

    .actions {
        margin-top: 18px;
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .btn-save {
        background: #1da1f2;
        color: white;
        padding: 11px 16px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 700;
    }

    .btn-cancel {
        background: transparent;
        border: none;
        color: #0d3b5f;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
    }

    @@media (max-width: 700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="create-page">
    <div class="create-card">
        <div class="create-header">
            <h1>Create Tournament</h1>
            <p>Quickly create a new Rocket League tournament.</p>
        </div>

        <div class="create-body">
            <div asp-validation-summary="All"></div>

            <form method="post">
                <div class="form-grid">
                    <div class="form-group form-group-full">
                        <label asp-for="Tournament.Naam">Name</label>
                        <input asp-for="Tournament.Naam" placeholder="Example: Scrim Manager Summer Cup" />
                        <span asp-validation-for="Tournament.Naam"></span>
                    </div>

                    <div class="form-group form-group-full">
                        <label asp-for="Tournament.Organisator">Organizer</label>
                        <input asp-for="Tournament.Organisator" placeholder="Example: Burhan" />
                        <span asp-validation-for="Tournament.Organisator"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="SelectedDate">Start Date</label>
                        <input asp-for="SelectedDate" type="date" />
                        <span asp-validation-for="SelectedDate"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="SelectedTime">Start Time</label>
                        <input asp-for="SelectedTime" type="time" />
                        <span asp-validation-for="SelectedTime"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Tournament.Format">Format</label>
                        <select asp-for="Tournament.Format">
                            <option value="">-- Select format --</option>
                            <option value="1v1">1v1</option>
                            <option value="2v2">2v2</option>
                            <option value="3v3">3v3</option>
                        </select>
                        <span asp-validation-for="Tournament.Format"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Tournament.MaxTeams">Max Teams</label>
                        <select asp-for="Tournament.MaxTeams">
                            <option value="">-- Select max teams --</option>
                            <option value="8">8</option>
                            <option value="16">16</option>
                            <option value="32">32</option>
                            <option value="64">64</option>
                        </select>
                        <span asp-validation-for="Tournament.MaxTeams"></span>
                    </div>
                </div>

                <div class="helper-text">
                    Status will automatically be set to <strong>Open</strong> after saving.
                </div>

                <div class="actions">
                    <button type="submit" class="btn-save">Save Tournament</button>
                    <a asp-page="/Tournaments/TournamentIndex" class="btn-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}